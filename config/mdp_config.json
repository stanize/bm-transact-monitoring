{
  "heartbeat_metric_name": "transact_monitoring_heartbeat",
  "interval_seconds": 60,
  "logging": {
    "level": "INFO",
    "max_bytes": 10485760,
    "backup_count": 7
  },
  "mdp_scripts": [
    { "script": "mdp_tsm_status.py",           "metric_name": "transact_tsm_status",              "enabled": "y" },
    { "script": "mdp_concurrent_users.py",      "metric_name": "transact_concurrent_users",        "enabled": "y" },
    { "script": "mdp_license_expiry_days.py",   "metric_name": "transact_license_days_remaining",  "enabled": "y" },
    { "script": "mdp_jboss_status.py",          "metric_name": "transact_jboss_status",            "enabled": "y" },
    { "script": "mdp_tsa_services_running.py",  "metric_name": "transact_tsa_services_running",    "enabled": "y" },
    { "script": "mdp_business_date.py",         "metric_name": "transact_business_date",           "enabled": "y" },
    { "script": "mdp_transact_release.py",      "metric_name": "transact_release",                 "enabled": "y" },
    { "script": "mdp_https_availability.py",    "metric_name": "transact_https_availability",      "enabled": "y" },
    { "script": "mdp_eod_error_count.py",       "metric_name": "transact_eod_error_count",         "enabled": "y" },
    { "script": "mdp_cob_progress.py",          "metric_name": "transact_cob_progress",            "enabled": "y" },
    { "script": "mdp_cob_duration.py",          "metric_name": "transact_cob_duration",            "enabled": "y" },
    { "script": "mdp_memory_used_mb.py",        "metric_name": "transact_memory_used_mb",          "enabled": "y" },
    { "script": "mdp_memory_total_mb.py",       "metric_name": "transact_memory_total_mb",         "enabled": "y" },
    { "script": "mdp_cpu_usage_pct.py",         "metric_name": "transact_cpu_usage_pct",           "enabled": "y" },
    { "script": "mdp_ctmag_status.py",          "metric_name": "transact_ctmag_status",            "enabled": "y" }
  ]
}
